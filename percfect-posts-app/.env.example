# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for processing live payments and subscriptions.
# Get your secret key from https://dashboard.stripe.com/apikeys (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Public key for client-side Stripe checkout (pk_live_... or pk_test_...)
STRIPE_PUBLISHABLE_KEY=

# STRIPE_PRO_PRICE_ID: Optional Stripe Price ID for $7/mo or $60/yr Pro Plan (price_...)
STRIPE_PRO_PRICE_ID=

# STRIPE_PREMIUM_PRICE_ID: Optional Stripe Price ID for $12/mo or $100/yr Premium Plan (price_...)
STRIPE_PREMIUM_PRICE_ID=

# PERCFECT_AI_API_KEY: Direct API key for percfectai.com character generation, avatar rendering & video engine.
# Get or create your key at https://percfectai.com
PERCFECT_AI_API_KEY=

# PERCFECT_AI_ENDPOINT: Custom backend endpoint for percfectai.com rendering (defaults to https://api.percfectai.com/v1)
PERCFECT_AI_ENDPOINT=https://api.percfectai.com/v1
